# =============================================================================
# Queueless Backend - Environment Variables Template
# Copy to .env for local development or configure per service in Railway.
# Never commit real secrets or .env files to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# JWT Authentication (Required by: auth-service, customer-service, office-service)
# Must be identical across all three services and at least 32 characters long.
# Not used by api-gateway.
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME

# -----------------------------------------------------------------------------
# Shared MySQL Database (Required by: auth-service, customer-service, office-service)
# Not used by api-gateway.
# -----------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/queueless
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# Downstream Microservice URLs (Required by: api-gateway)
# Do not include a trailing slash. In Railway, set to internal/service URLs.
# -----------------------------------------------------------------------------
SERVICES_AUTH_URL=http://localhost:8082
SERVICES_OFFICE_URL=http://localhost:8083
SERVICES_CUSTOMER_URL=http://localhost:8084

# -----------------------------------------------------------------------------
# Office Document Storage (Used by: office-service)
# Local default: uploads/documents
# Railway Volume mounted at /app/uploads -> set /app/uploads/documents
# -----------------------------------------------------------------------------
UPLOAD_DIR=uploads/documents

# -----------------------------------------------------------------------------
# Firebase Authentication (Used by: auth-service)
# Comma-separated Firebase project IDs allowed for Google/Firebase ID tokens.
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_IDS=CHANGE_ME

# -----------------------------------------------------------------------------
# AI Assistant Integration (Optional for: customer-service)
# Falls back to the built-in rule engine if omitted or blank.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=CHANGE_ME
